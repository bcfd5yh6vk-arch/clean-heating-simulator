  },
  "homepage": "https://github.com/bcfd5yh6vk-arch/clean-heating-simulator#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
