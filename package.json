{
  "name": "ctb25-26",
  "version": "1.0.0",
  "description": "一个面向保定煤改X区域的清洁取暖转型模拟沙盘，用农户家庭数据比较不同取暖路径的可负担性，并为村级清洁取暖决策提供参考。",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc && npm run bundle",
    "bundle": "esbuild docs/src/global/index.ts --bundle --format=iife --global-name=GlobalEngine --target=es2019 --outfile=docs/global/engine.bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test docs/tests/global/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcfd5yh6vk-arch/clean-heating-simulator.git"
  },
