{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/china", "destination": "/index.html" },
    { "source": "/global", "destination": "/docs/global/landing.html" },
    { "source": "/advisor", "destination": "/docs/global/index.html" },
    { "source": "/story", "destination": "/docs/global/story.html" },
    { "source": "/impact", "destination": "/docs/global/impact.html" }
  ]
}
